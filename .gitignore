# ---- 数据文件不入库（体积大、可由脚本重新生成）----
data/raw/*.csv
data/generated/*.csv
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 多数据集目录：每个上传的数据集一个子目录（<id>/data.db + <id>/raw/*.csv）。
# 【为什么必须单列一条？】上面的 `data/*.db` 只匹配 data/ 下的**一层**文件，
#   匹配不到 data/datasets/<id>/data.db 这种嵌套路径 —— 上传的数据会被误提交。
# index.json 也一并忽略：它是「派生状态」而非源资产，首次构造时
# ensure_builtin() 会自动重建，任何克隆都能自愈（详见 src/data/dataset.py）。
data/datasets/

# 指标方案目录：用户经「半自动指标草稿闭环」确认落盘的方案（<id>/metrics_registry.json）。
# 【为什么它也属于「运行时产物」？】内置方案 src/metrics/metrics_registry.json 是
#   受版本管理、经指标委员会评审的**源码资产**；而这里的方案由上传数据集的表结构
#   推导 + 人工勾选确认产生，因人、因数据而异，没有跨机器复现的意义。
#   两者混进同一个目录后，就再也分不清哪份 JSON 该被评审、哪份可以随手删。
data/schemes/

# ---- 环境与密钥 ----
.env
.venv/
venv/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- 本地个人存档（不入库）----
# 说明：从主文档中抽出的个人存档类文本（如 *_本地存档.txt），仅本地保留，
#       不进入仓库。用通配符而非点名具体文件，避免本文件反向暴露内容。
*_本地存档.txt

# ---- IDE / 系统 ----
.idea/
.vscode/
.trae/
.DS_Store
Thumbs.db